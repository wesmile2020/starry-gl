{
  "name": "starry-gl",
  "version": "1.0.0",
  "description": "A 3D library based on WebGL/WebGPU",
  "keywords": [
    "WebGL",
    "WebGPU",
    "3D"
  ],
  "homepage": "https://github.com/wesmile2020/starry-gl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesmile2020/starry-gl.git"
  },
  "bugs": {
    "url": "https://github.com/wesmile2020/starry-gl/issues"
  },
  "license": "MIT",
  "author": "lei.li",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/starry-gl.js",
  "types": "./dist/starry-gl.d.ts",
  "exports": {
    ".": {
      "import": "./dist/starry-gl.js",
      "require": "./dist/starry-gl.umd.cjs",
      "types": "./dist/starry-gl.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run typings",
    "typings": "extract-typings -e ./src/index.ts -o dist/typings -f starry-gl -c"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^25.0.7",
    "@types/stats.js": "^0.17.4",
    "@webgpu/types": "^0.1.72",
    "extract-typings": "^6.0.1",
    "stats.js": "^0.17.0",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-glsl": "^1.6.1"
  },
  "dependencies": {
    "@mapbox/tiny-sdf": "^2.2.0",
    "earcut": "^3.2.3",
    "starry-math": "^1.0.1"
  }
}
